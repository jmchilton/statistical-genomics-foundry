---
import Base from '../../layouts/Base.astro';
import { getEntriesByTag } from '../../lib/tags';
import { tagRegistry } from '../../lib/meta-tags';
import { groupTagsInUse } from '../../lib/tag-browse';
import { base } from '../../lib/site-base';

const registry = tagRegistry();
const byTag = await getEntriesByTag();

// What a tagged thing IS belongs to this instance: an entry in any of five collections. How the
// tags then browse does not, and used to be spelled out here — grouped by declaring facet, the
// registry's order kept, unused facets dropped. See lib/tag-browse.ts for why that has one reader.
const counts = new Map([...byTag].map(([tag, entries]) => [tag, entries.length] as const));
const sections = groupTagsInUse(registry, counts);

const facetList = registry.facets().map(f => f.label).join(', ');
---
<Base title="Tags">
  <span class="eyebrow mb-3">Tags</span>
  <h1 class="text-3xl font-bold mb-2">Tags</h1>
  <p class="text-(--color-text-secondary) max-w-2xl mb-8">
    The inverse of the chips on each page — every tag in use, and what carries it. Tags are
    grouped into facets ({facetList}) and validated against <code>meta_tags.yml</code>, which
    documents every one of them. {byTag.size} tags in use across the corpus.
  </p>

  {sections.map(s => (
    <section class="mb-8" aria-labelledby={`ns-${s.key}`}>
      <h2 id={`ns-${s.key}`} class="text-sm font-bold uppercase tracking-wider text-(--color-text-muted) mb-1">{s.label}</h2>
      <p class="text-sm text-(--color-text-secondary) max-w-2xl mb-3">{s.description}</p>
      <ul class="list-none p-0 m-0 grid gap-3 sm:grid-cols-2">
        {s.tags.map(t => (
          <li>
            <a href={`${base}/tags/${t.tag}/`} class="card flex flex-col">
              <div class="flex items-baseline justify-between gap-2">
                <span class="tag">{t.tag}</span>
                <span class="text-xs text-(--color-text-muted) shrink-0">{t.count} {t.count === 1 ? 'entry' : 'entries'}</span>
              </div>
              {t.gloss && <div class="text-sm text-(--color-text-secondary) mt-1">{t.gloss}</div>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>

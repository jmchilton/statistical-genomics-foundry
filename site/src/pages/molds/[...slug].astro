---
import { getCollection, render } from 'astro:content';
import { existsSync } from 'node:fs';
import Base from '../../layouts/Base.astro';
import TagChips from '../../components/TagChips.astro';
import { repoPath } from '../../lib/repo-root';

export async function getStaticPaths() {
  const entries = await getCollection('molds');
  return entries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

// Anchored on the project root, not on this file's depth — see the note on the index page.
const hasSibling = (file: string) => existsSync(repoPath('content/molds', entry.id, file));
---
<Base title={d.name}>
  <div data-pagefind-body>
    <a href={`${base}/molds/`} class="text-sm text-(--color-text-muted) no-underline hover:underline">← Molds</a>
    <div class="flex flex-wrap items-center gap-2 mt-3 mb-6 text-xs">
      <TagChips tags={d.tags} />
      <span class="text-(--color-text-muted)">eval {hasSibling('eval.md') ? '✓' : '—'} · scenarios {hasSibling('scenarios.md') ? '✓' : '—'}</span>
    </div>
    <article class="prose prose-slate max-w-none dark:prose-invert">
      <Content />
    </article>
  </div>
</Base>

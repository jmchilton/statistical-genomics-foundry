---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const entries = await getCollection('meta');
  return entries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const shelf = d.record_kind === 'infrastructure' ? 'project infrastructure' : 'design record';
---
<Base title={d.title} description={d.summary}>
  <div>
    <a href={`${base}/design/`} class="text-sm text-(--color-text-muted) no-underline hover:underline">← Design record</a>
    <div class="flex flex-wrap items-center gap-2 mt-3 mb-2 text-xs">
      <span class="rounded bg-(--color-surface-raised) border border-(--color-border-subtle) text-(--color-text-secondary) px-2 py-0.5 font-mono">{shelf}</span>
      <span class="rounded bg-(--color-surface-raised) border border-(--color-border-subtle) text-(--color-text-muted) px-2 py-0.5 font-mono">{d.status}</span>
    </div>
    <h1 class="text-3xl font-bold mt-2 mb-2" data-pagefind-meta="title">{d.title}</h1>
    <p class="text-(--color-text-secondary) mb-6" data-pagefind-meta="summary">{d.summary}</p>
    <article class="prose prose-slate max-w-none dark:prose-invert">
      <Content />
    </article>
  </div>
</Base>

{
  "name": "statistical-genomics-foundry-site",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build --force",
    "typecheck": "astro check",
    "kinds": "vite-node scripts/generate-kind-manifest.ts",
    "check:kinds": "vite-node scripts/generate-kind-manifest.ts --check",
    "books": "vite-node scripts/generate-book-frontmatter.ts",
    "check:books": "vite-node scripts/generate-book-frontmatter.ts --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "vitest run",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@fontsource/atkinson-hyperlegible": "^5.2.8",
    "@galaxy-foundry/content-reader": "^0.2.0",
    "@galaxy-foundry/kind-manifest": "^0.4.0",
    "@galaxy-foundry/kind-schema": "^0.5.0",
    "@galaxy-foundry/license-policy": "^0.4.0",
    "@galaxy-foundry/reference-contract": "^0.3.0",
    "@galaxy-foundry/site-kit": "^0.8.0",
    "@galaxy-foundry/tag-registry": "^0.1.0",
    "@galaxy-foundry/wiki-links": "^0.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "4.3.3",
    "astro": "^7.1.6",
    "js-yaml": "^4.1.0",
    "katex": "^0.16.45",
    "marked": "^18.0.2",
    "marked-katex-extension": "^5.1.8",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "astro-pagefind": "^2.0.1",
    "pagefind": "^1.5.2",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vite-node": "^3.2.4",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.12.0"
  }

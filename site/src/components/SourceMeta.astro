---
// Source/license box, shared by books (license_file → in-app license page) and
// source notes (papers/tutorials: optional version/access-date pins).
// The redistribution policy (verbatim-ok vs own-words-only, copyleft, obligations)
// is derived mechanically from the license id via the shared policy table shipped in
// @galaxy-foundry/license-policy — not restated per note.
//
// The props mirror @galaxy-foundry/source-note's field set rather than the flat strings this
// box used to take: `sourceIds` is a union so "no identifier" can be rendered as the claim it
// is, and `sourceLicense` is a union so a licence nobody determined is not drawn as a licence.
import type { SourceReadLevel } from '@galaxy-foundry/source-note';

interface Props {
  /** The containing work, where a note is part of one — a book id. Papers stand alone. */
  source?: string;
  sourceChapter?: number;
  sourceUrl: string;
  sourceIds:
    | { status: 'declared'; doi?: string; pmid?: string; pmcid?: string; arxiv?: string }
    | { status: 'none'; reason: string };
  sourceLicense: { status: 'declared'; id: string } | { status: 'missing' };
  licenseFile?: string;
  citation: string;
  attribution?: string;
  derived?: string;
  sourceRead: SourceReadLevel;
  version?: string;
  accessDate?: string;
}
import { bundledPolicy, resolveLicenseRow } from '@galaxy-foundry/license-policy';
import { licenseFileHref } from '@galaxy-foundry/site-kit';
import LicenseBadge from '@galaxy-foundry/site-kit/LicenseBadge.astro';
import { base } from '../lib/site-base';
const {
  source,
  sourceChapter,
  sourceUrl,
  sourceIds,
  sourceLicense,
  licenseFile,
  citation,
  attribution,
  derived,
  sourceRead,
  version,
  accessDate,
} = Astro.props;
const licenseHref = licenseFile ? licenseFileHref(base, licenseFile) : null;
const doi = sourceIds.status === 'declared' ? sourceIds.doi : undefined;
const arxiv = sourceIds.status === 'declared' ? sourceIds.arxiv : undefined;
const doiHref = doi ? `https://doi.org/${doi}` : null;
const arxivHref = arxiv ? `https://arxiv.org/abs/${arxiv}` : null;

// The notice a licence obliges CONTAINS the bibliographic record — it is the citation plus the
// terms it was used under — so printing both would print the record twice. Where no notice is
// owed (own words carry no upstream expression), the record itself is what a reader wants.
const provenance = attribution ?? citation;

// Anything short of a full read bounds what the summary below can support, which is the reader's
// problem and not just the author's. `full-text` is the unremarkable case and stays unlabelled.
const READ_LABEL: Record<SourceReadLevel, string | null> = {
  'full-text': null,
  partial: 'partial read',
  'abstract-only': 'abstract only',
  'not-read': 'source not read',
};
const readLabel = READ_LABEL[sourceRead];

// Still resolved here for `policy`, which decides the "no redistributable text" line below. The
// chips themselves are the badge's — what a licence PERMITS travels with the licence, while the
// attribution and the derived-from line are what THIS note owes for using it.
const policy = bundledPolicy();
const row = sourceLicense.status === 'declared' ? resolveLicenseRow(policy, sourceLicense.id) : null;
---
<aside class="not-prose mb-6 rounded-lg border border-(--color-border-subtle) bg-(--color-surface-raised) p-4 text-sm">
  <div class="flex flex-wrap items-center gap-2 mb-2">
    {source && <span class="meta-pill">{source}{sourceChapter !== undefined ? ` · ch ${sourceChapter}` : ''}</span>}
    {version && <span class="meta-pill">{version}</span>}
    {readLabel && <span class="meta-pill">{readLabel}</span>}
    {sourceLicense.status === 'declared' && <LicenseBadge license={sourceLicense.id} policy={policy} />}
  </div>
  <p class="text-(--color-text-secondary) m-0">
    {provenance}
  </p>
  {derived && (
    <p class="text-(--color-text-muted) mt-1 mb-0 text-xs">
      Changes from source: {derived}
    </p>
  )}
  <p class="text-(--color-text-muted) mt-2 mb-0">
    <a href={sourceUrl} class="text-(--color-link) hover:text-(--color-link-hover)">Original source ↗</a>
    {doiHref && (<><span aria-hidden="true"> · </span><a href={doiHref} class="text-(--color-link) hover:text-(--color-link-hover)">doi:{doi}</a></>)}
    {arxivHref && (<><span aria-hidden="true"> · </span><a href={arxivHref} class="text-(--color-link) hover:text-(--color-link-hover)">arXiv:{arxiv}</a></>)}
    {licenseHref && (<><span aria-hidden="true"> · </span><a href={licenseHref} class="text-(--color-link) hover:text-(--color-link-hover)">License terms</a></>)}
    {!licenseHref && row?.policy === 'own-words-only' && (<><span aria-hidden="true"> · </span><span class="italic">no redistributable text — own-words summary</span></>)}
    {sourceLicense.status === 'missing' && (<><span aria-hidden="true"> · </span><span class="italic">no license determined</span></>)}
    {accessDate && <span class="text-(--color-text-muted)"> · accessed {accessDate}</span>}
  </p>
</aside>

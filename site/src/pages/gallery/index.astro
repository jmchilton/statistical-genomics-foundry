---
import {
  sharesPage,
  specimenPath,
  type Specimen,
  type SpecimenGroup,
} from '@galaxy-foundry/site-kit/specimens';

import GallerySpecimen from '../../components/GallerySpecimen.astro';
import RefereeLoop from '../../components/RefereeLoop.astro';
import Base from '../../layouts/Base.astro';
import { ALL_SPECIMENS, specimenOrigin } from '../../lib/gallery';
import { GALLERY_RENDERERS } from '../../lib/gallery-renderers';
import { base } from '../../lib/site-base';

const inlineGroups = ALL_SPECIMENS.filter(sharesPage);
const framedGroups = ALL_SPECIMENS.filter((group) => !sharesPage(group));
const sharedGroups = ALL_SPECIMENS.filter((group) => specimenOrigin(group) === 'shared');
const sgfGroups = ALL_SPECIMENS.filter((group) => specimenOrigin(group) === 'sgf');

const specimenHref = (group: SpecimenGroup, specimen: Specimen): string =>
  `${base}/gallery/${specimenPath(group, specimen)}/`;
---

<Base
  title="Component gallery"
  description="Shared Foundry components and statistical-genomics visual patterns, rendered together in this instance's theme."
>
  <header class="gallery-hero" aria-labelledby="gallery-title">
    <div class="gallery-title-block">
      <p class="eyebrow">Shared substrate · local expression</p>
      <h1 id="gallery-title">The evidence surfaces this Foundry trusts.</h1>
    </div>
    <div class="gallery-intro">
      <p>
        Shared cases come directly from <code>@galaxy-foundry/site-kit</code>. This page gives them
        no alternate palette, so the shell, note frame, reference cards, tags, and licence surfaces
        appear exactly as they do across the SGF reading application.
      </p>
      <p>
        Instance cases keep the domain boundary visible: corpus provenance, this Foundry's own
        reference vocabulary, and the analyze–referee–revise loop that prevents work from
        self-certifying.
      </p>
    </div>
  </header>

  <div class="gallery-loop-lead">
    <RefereeLoop subject="Batch-confounding audit" verdict="revise" />
  </div>

  <section class="gallery-ledger" aria-label="Gallery coverage">
    <div>
      <span>Shared</span>
      <strong>{sharedGroups.length}</strong>
      <p>Component groups supplied and maintained by site-kit.</p>
    </div>
    <div>
      <span>Instance</span>
      <strong>{sgfGroups.length}</strong>
      <p>Groups derived from SGF vocabulary and presentation.</p>
    </div>
  </section>

  <nav class="gallery-index" aria-label="Component groups">
    {ALL_SPECIMENS.map((group) => (
      <a href={`#${group.id}`} data-origin={specimenOrigin(group)}>
        <span>{specimenOrigin(group) === 'shared' ? 'site-kit' : 'sgf'}</span>
        <strong>{group.component}</strong>
        <small>{group.specimens.length} {group.specimens.length === 1 ? 'case' : 'cases'} · {group.surface}</small>
      </a>
    ))}
  </nav>

  {inlineGroups.map((group) => {
    const Component = GALLERY_RENDERERS[group.component]!;
    const origin = specimenOrigin(group);
    return (
      <section id={group.id} class="gallery-group" data-origin={origin}>
        <header class="gallery-group-heading">
          <div>
            <span>{origin === 'shared' ? 'Shared component' : 'SGF component'}</span>
            <h2>{group.component}</h2>
          </div>
          <p>{group.summary}</p>
        </header>
        {group.specimens.map((specimen) => (
          <GallerySpecimen group={group} specimen={specimen} origin={origin}>
            <Component {...(specimen.props as Record<string, unknown>)}>
              <p>
                A short note body makes the shared frame visible without inventing a second
                content model for the gallery.
              </p>
            </Component>
          </GallerySpecimen>
        ))}
      </section>
    );
  })}

  {framedGroups.map((group) => {
    const origin = specimenOrigin(group);
    return (
      <section id={group.id} class="gallery-group" data-origin={origin}>
        <header class="gallery-group-heading">
          <div>
            <span>{origin === 'shared' ? 'Shared component' : 'SGF component'}</span>
            <h2>{group.component}</h2>
          </div>
          <p>
            {group.summary} Its <code>{group.surface}</code> surface receives a real route rather
            than a second copy on this document.
          </p>
        </header>
        {group.specimens.map((specimen) => (
          <GallerySpecimen group={group} specimen={specimen} origin={origin}>
            <iframe
              src={specimenHref(group, specimen)}
              title={`${group.component}: ${specimen.name}`}
              loading="lazy"
              class:list={{
                'gallery-frame': true,
                'gallery-frame-shell': group.component === 'SiteShell',
              }}
            />
            <a class="gallery-frame-link" href={specimenHref(group, specimen)}>
              Open {specimenPath(group, specimen)} full width
            </a>
          </GallerySpecimen>
        ))}
      </section>
    );
  })}
</Base>

<style>
  .gallery-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(18rem, 0.72fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: end;
    padding: clamp(4rem, 9vw, 7rem) 0 clamp(2.5rem, 6vw, 4.5rem);
  }

  .gallery-title-block {
    position: relative;
  }

  .gallery-title-block::before {
    position: absolute;
    top: -2.4rem;
    left: 0;
    width: 4.5rem;
    height: 0.3rem;
    background: var(--color-accent);
    content: '';
  }

  .gallery-hero h1 {
    max-width: 13ch;
    margin: 0.4rem 0 0;
    color: var(--color-chrome);
    font-size: clamp(2.8rem, 6vw, 5.4rem);
    font-weight: 700;
    letter-spacing: -0.055em;
    line-height: 0.96;
    text-wrap: balance;
  }

  .dark .gallery-hero h1 {
    color: var(--color-text-primary);
  }

  .gallery-intro {
    padding-left: 1.25rem;
    border-left: 2px solid var(--color-brand);
  }

  .gallery-intro p {
    margin: 0;
    color: var(--color-text-secondary);
    line-height: 1.7;
    text-wrap: pretty;
  }

  .gallery-intro p + p {
    margin-top: 1rem;
  }

  .gallery-intro code,
  .gallery-group-heading code {
    border-radius: 0.2rem;
    background: var(--color-surface-hover);
    padding: 0.08rem 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.82em;
  }

  .gallery-loop-lead {
    margin-bottom: clamp(3rem, 7vw, 5rem);
  }

  .gallery-ledger {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    margin-bottom: 2rem;
    border-top: 1px solid var(--color-border-subtle);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .gallery-ledger > div {
    display: grid;
    grid-template-columns: auto auto 1fr;
    gap: 0.9rem;
    align-items: baseline;
    padding: 1.2rem 0;
  }

  .gallery-ledger > div + div {
    padding-left: 1.5rem;
    border-left: 1px solid var(--color-border-subtle);
  }

  .gallery-ledger span,
  .gallery-ledger strong {
    font-family: var(--font-mono);
  }

  .gallery-ledger span {
    color: var(--color-text-muted);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .gallery-ledger strong {
    color: var(--color-brand);
    font-size: 1.45rem;
  }

  .gallery-ledger p {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.82rem;
  }

  .gallery-index {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-bottom: clamp(5rem, 10vw, 9rem);
    border-top: 1px solid var(--color-border-subtle);
  }

  .gallery-index a {
    display: grid;
    grid-template-columns: 4.5rem 1fr auto;
    gap: 0.8rem;
    align-items: baseline;
    padding: 0.9rem 0.75rem;
    border-bottom: 1px solid var(--color-border-subtle);
    color: var(--color-text-primary);
    text-decoration: none;
    transition: background-color 180ms ease, transform 180ms ease;
  }

  .gallery-index a:nth-child(odd) {
    border-right: 1px solid var(--color-border-subtle);
  }

  .gallery-index a:hover {
    background: var(--color-surface-hover);
    transform: translateX(0.2rem);
  }

  .gallery-index a:active {
    transform: translateX(0.1rem) scale(0.995);
  }

  .gallery-index span,
  .gallery-index small {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .gallery-index [data-origin='sgf'] span {
    color: var(--color-brand);
  }

  .gallery-group {
    margin-top: clamp(5rem, 10vw, 9rem);
    scroll-margin-top: 5rem;
  }

  .gallery-group-heading {
    display: grid;
    grid-template-columns: minmax(12rem, 0.55fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    align-items: end;
    margin-bottom: 0.5rem;
  }

  .gallery-group-heading span {
    color: var(--color-brand);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .gallery-group-heading h2 {
    margin: 0.35rem 0 0;
    color: var(--color-text-primary);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .gallery-group-heading p {
    max-width: 62ch;
    margin: 0;
    color: var(--color-text-secondary);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .gallery-frame {
    display: block;
    width: 100%;
    height: 19rem;
    border: 0;
    background: var(--color-surface);
  }

  .gallery-frame-shell {
    height: 38rem;
  }

  .gallery-frame-link {
    display: inline-block;
    margin: 0.8rem 1rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  @media (max-width: 760px) {
    .gallery-hero,
    .gallery-group-heading,
    .gallery-index,
    .gallery-ledger {
      grid-template-columns: 1fr;
    }

    .gallery-hero h1 {
      font-size: clamp(2.6rem, 13vw, 4.5rem);
    }

    .gallery-index a:nth-child(odd),
    .gallery-ledger > div + div {
      border-right: 0;
      border-left: 0;
    }

    .gallery-ledger > div + div {
      padding-left: 0;
      border-top: 1px solid var(--color-border-subtle);
    }

    .gallery-index a {
      grid-template-columns: 3.8rem 1fr;
    }

    .gallery-index small {
      grid-column: 2;
    }
  }
</style>

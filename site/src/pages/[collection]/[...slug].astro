---
// The detail page for every note in the corpus, whichever collection it belongs to.
//
// This used to be six files. They agreed on everything a reader would notice — the search-indexed
// wrapper, the tag chips, the prose article — and agreed by coincidence, because nothing compared
// them. Coincidence is a poor guarantee and it had already failed once: four of the five tagged
// collections rendered no chips at all, and every one of those pages looked complete from inside
// its own file. What differs per collection is small enough to state as data, so it is, in
// `lib/detail-routes.ts`; what is kind-specific furniture is dispatched below, on the collection.
//
// `tests/detail-route.test.ts` is what keeps it one file.
import { getCollection, render } from 'astro:content';
import { existsSync } from 'node:fs';

import ReferenceContract from '@galaxy-foundry/site-kit/ReferenceContract.astro';
import ContentNote from '@galaxy-foundry/site-kit/ContentNote.astro';
import SourceMeta from '../../components/SourceMeta.astro';
import Base from '../../layouts/Base.astro';
import { DESIGN_DOCS } from '../../lib/design-docs';
import { DETAIL_ROUTES, kindTitle } from '../../lib/detail-routes';
import { referenceContract } from '../../lib/reference-contract';
import { repoPath } from '../../lib/repo-root';
import { base } from '../../lib/site-base';
import { COLLECTION_LABEL } from '../../lib/tags';
import { buildWikiLinkMap, resolveWikiLink } from '../../lib/wiki-links';

export async function getStaticPaths() {
  // Spelled out per collection rather than mapped over `COLLECTION_NAMES`, for the reason
  // `frontmatter-schema.ts` assembles its schemas one by one: a loop yields a homogeneous array
  // and every kind's shape collapses to the widest common type, which arrives here as an
  // `entry.data` this page can say nothing about. Spread into one array they stay a UNION, and
  // `entry.collection` discriminates it — so the branches below are checked, not asserted.
  const entries = [
    ...(await getCollection('meta')),
    ...(await getCollection('books')),
    ...(await getCollection('papers')),
    ...(await getCollection('tutorials')),
    ...(await getCollection('molds')),
    ...(await getCollection('patterns')),
  ];
  return entries.map(entry => ({
    params: { collection: entry.collection, slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const route = DETAIL_ROUTES[entry.collection];

// Molds and Patterns name themselves; everything else carries a title. Read by presence rather
// than from a column in the table — a fact derivable from the note is not configuration.
const title = 'title' in d ? d.title : d.name;

// A chip is a LINK, and the tag pages index only the collections `COLLECTION_LABEL` names — so a
// chip on a page outside that set points somewhere that will not list the note back. Design
// records carry tags and are not on the tag surface, which the six-route version hid by simply
// never rendering chips there; stated here it is visible as the open question it is.
const tags = entry.collection in COLLECTION_LABEL && 'tags' in d ? d.tags : [];
// Every note that has one, not only the ones whose page also states a heading. The frame weights
// the summary at 10 for search, and that attribute is on an element no page here draws — so a
// summary withheld from the frame is a note ranking behind anything that mentions its subject.
const summary = 'summary' in d ? d.summary : undefined;

// The kind, and what this note adds to it. `record_kind` and `pole` were pills beside the status
// until the frame arrived with a line for exactly this: they say what the note IS, where a status
// says how it is doing, and reading them as two more pills made the three look interchangeable.
//
// A shelf REPLACES the kind name — an infrastructure record is not a design record with a
// qualifier — while a pole QUALIFIES it, because a cautionary pattern is still a pattern.
const eyebrow =
  entry.collection === 'meta'
    ? entry.data.record_kind === 'infrastructure'
      ? 'Project Infrastructure'
      : kindTitle('meta')
    : entry.collection === 'patterns' && entry.data.pole
      ? `${kindTitle('patterns')} · ${entry.data.pole}`
      : kindTitle(entry.collection);

// Read by presence, like the heading: two of six kinds declare a status, and which those are is
// the schema's answer rather than a list kept here. The frame draws the pill and `global.css`
// colours it per value, so a status added to a kind is a rule there and nothing here.
const status = 'status' in d ? d.status : undefined;

const hasCompanion = (file: string) => existsSync(repoPath('content/molds', entry.id, file));

// How a `ref` becomes a link is this site's question, not the contract's — every kind here
// declares `ref_shape: wiki-link`, so it is the same resolver the prose goes through. Passing the
// site's own resolver rather than a link map is what keeps a ref in a manifest and a `[[ref]]` in
// a paragraph from resolving to two different places.
const linkMap = buildWikiLinkMap(DESIGN_DOCS);
const resolveRef = (ref: string) => resolveWikiLink(ref, linkMap, base);
---
<Base title={title} description={summary}>
  <ContentNote
    title={title}
    eyebrow={eyebrow}
    summary={summary}
    status={status}
    tags={tags}
    tagBase={`${base}/tags`}
    back={route.back ? { href: `${base}${route.back.path}`, label: route.back.label } : undefined}
    showHeading={route.heading === true}
    articleClass="prose prose-slate max-w-none dark:prose-invert"
  >
    {entry.collection === 'books' && (
      <SourceMeta
        slot="metadata"
        source={entry.data.source}
        sourceChapter={entry.data.source_chapter}
        sourceUrl={entry.data.source_url}
        license={entry.data.license}
        licenseFile={entry.data.license_file}
        attribution={entry.data.attribution}
        derived={entry.data.derived}
      />
    )}
    {(entry.collection === 'papers' || entry.collection === 'tutorials') && (
      <SourceMeta
        slot="metadata"
        source={entry.data.source_id}
        sourceUrl={entry.data.source_url}
        license={entry.data.license}
        licenseFile={entry.data.license_file}
        attribution={entry.data.attribution}
        derived={entry.data.derived}
        doi={entry.data.doi}
        version={entry.data.version}
        accessDate={entry.data.access_date}
      />
    )}

    <Fragment slot="badges">
      {entry.collection === 'molds' && (
        <span class="text-xs text-(--color-text-muted)">eval {hasCompanion('eval.md') ? '✓' : '—'} · scenarios {hasCompanion('scenarios.md') ? '✓' : '—'}</span>
      )}
    </Fragment>

    {entry.collection === 'molds' && (
      <ReferenceContract
        slot="reference"
        references={entry.data.references ?? []}
        contract={referenceContract()}
        resolveRef={resolveRef}
      />
    )}

    <Content />
  </ContentNote>
</Base>

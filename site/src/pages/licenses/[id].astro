---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getLicenses } from '../../lib/licenses';
import { bundledPolicy, redistributesUnder } from '@galaxy-foundry/license-policy';
import type { LicenseFileUse } from '@galaxy-foundry/site-kit';
import LicenseFileBody from '@galaxy-foundry/site-kit/LicenseFileBody.astro';
import { base } from '../../lib/site-base';

export async function getStaticPaths() {
  return getLicenses().map(licenseFile => ({
    params: { id: licenseFile.id },
    props: { licenseFile },
  }));
}

const { licenseFile } = Astro.props;

// The per-instance half: our notes live in three collections and are addressed as
// `/{collection}/{id}/`, so this walk and these hrefs stay here. The membership test does not —
// `redistributesUnder` compares a note's `license_file` against a FILE id, which this page used to
// spell as an equality between two things both called `licenseId`. A copy is keyed by source, so
// two books under one licence have two copies and this page must not list the other's notes.
const collections = ['books', 'papers', 'tutorials'] as const;
const entries = (await Promise.all(
  collections.map(async c => (await getCollection(c)).map(e => ({ e, collection: c }))),
)).flat();
const uses: LicenseFileUse[] = entries
  .filter(({ e }) => redistributesUnder(e.data.license_file, licenseFile.id))
  .map(({ e, collection }) => ({
    href: `${base}/${collection}/${e.id}/`,
    label: e.id,
    licenseId: e.data.license,
  }))
  .sort((a, b) => a.label.localeCompare(b.label));
---
<Base title={`License — ${licenseFile.filename}`} description={`License terms for ${licenseFile.filename}.`}>
  <article class="license">
    <header class="license-header">
      <span class="license-eyebrow">
        <span class="license-eyebrow-rule" aria-hidden="true"></span>
        <span>imported-content license</span>
      </span>
      <h1 data-pagefind-meta="title">{licenseFile.filename}</h1>
    </header>

    <LicenseFileBody licenseFile={licenseFile} policy={bundledPolicy()} uses={uses} />
  </article>
</Base>

<style>
  .license {
    max-width: 58rem;
  }
  .license-header {
    margin-bottom: 1.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }
  .license-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .license-eyebrow-rule {
    width: 1.5rem;
    height: 2px;
    background: var(--color-accent);
  }
  .license-header h1 {
    margin: 0.55rem 0 0;
    color: var(--color-text-primary);
    font-family: var(--font-mono);
    font-size: clamp(1.3rem, 1.6vw + 0.5rem, 1.7rem);
    letter-spacing: -0.01em;
  }
</style>
